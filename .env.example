# Site base URL (used for invite/reset email links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase (run `pnpm supabase:status` to get these values for local dev)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."

# Email notifications via Resend (https://resend.com)
RESEND_API_KEY="re_..."
# Optional: recipient address. If not set, email sending is skipped.
NOTIFICATION_EMAIL="john.doe@mail.com"
# Optional, local dev only: when "true", every outgoing email is redirected to
# Resend's test address (delivered@resend.dev) instead of the real recipient —
# https://resend.com/docs/dashboard/emails/send-test-emails
RESEND_TEST_MODE="false"
# Verifies signatures on the inbound-email webhook (app/api/webhooks/resend-inbound)
RESEND_WEBHOOK_SECRET=""

# Shared secret required by the reminders cron endpoint (app/api/reminders), sent as the x-cron-secret header
CRON_SECRET=""
# Also used by /api/cron/send-scheduled-requests, called by pg_cron; set the same value in Vault as `cron_secret` (plus `app_url`)
