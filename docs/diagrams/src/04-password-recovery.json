{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Recuperación de contraseña",
    "output": "04-password-recovery.html",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "frontend": { "label": "Usuario / UI" },
        "backend": { "label": "Servidor" },
        "security": { "label": "Sin revelar información" },
        "external": { "label": "Actor externo" }
      }
    }
  },
  "lanes": [
    { "id": "ui", "label": "Usuario / Navegador" },
    { "id": "server", "label": "Servidor" },
    { "id": "silent", "label": "Sin revelar información", "variant": "exception" }
  ],
  "phases": [
    { "id": "solicitud", "label": "Solicitar recuperación", "fromCol": 0, "toCol": 2 },
    { "id": "confirmacion", "label": "Confirmar y restablecer", "fromCol": 3, "toCol": 4, "variant": "emphasis" }
  ],
  "mainPath": ["submit", "lookup", "processreset", "verify", "setpassword"],
  "nodes": [
    { "id": "submit", "lane": "ui", "col": 0, "type": "external", "label": "Ingresa su email", "sublabel": "formulario /forgot-password", "width": 150 },
    { "id": "lookup", "lane": "server", "col": 1, "type": "backend", "label": "sendForgotPassword()", "sublabel": "busca el email", "width": 150, "tag": "app/actions/auth.ts" },
    { "id": "notfound", "lane": "silent", "col": 2, "type": "security", "label": "No existe o INACTIVE", "sublabel": "misma respuesta, sin enviar correo", "width": 190 },
    { "id": "processreset", "lane": "server", "col": 2, "type": "backend", "label": "Genera link + envía correo", "sublabel": "PENDING_RESET, Resend", "width": 190 },
    { "id": "verify", "lane": "server", "col": 3, "type": "backend", "label": "Verifica el token", "sublabel": "más tarde: clic en el enlace", "width": 160, "tag": "app/api/auth/verify" },
    { "id": "invalid", "lane": "silent", "col": 4, "type": "security", "label": "Token inválido/expirado", "sublabel": "redirige a /?error=link_expired", "width": 190 },
    { "id": "setpassword", "lane": "ui", "col": 4, "type": "frontend", "label": "Nueva contraseña", "sublabel": "updateUser() + activateAccount()", "tag": "status: ACTIVE", "width": 170 }
  ],
  "edges": [
    { "id": "submit-lookup", "from": "submit", "to": "lookup", "variant": "default" },
    { "id": "lookup-notfound", "from": "lookup", "to": "notfound", "label": "no existe / INACTIVE", "variant": "security" },
    { "id": "lookup-processreset", "from": "lookup", "to": "processreset", "label": "existe y activo", "variant": "emphasis" },
    { "id": "processreset-verify", "from": "processreset", "to": "verify", "label": "más tarde: clic en el enlace", "variant": "default" },
    { "id": "verify-invalid", "from": "verify", "to": "invalid", "label": "token inválido", "variant": "security", "role": "error" },
    { "id": "verify-setpassword", "from": "verify", "to": "setpassword", "label": "token válido", "variant": "emphasis" }
  ],
  "cards": [
    { "dot": "rose", "title": "No-enumeración", "items": ["Email inexistente o INACTIVE responde exactamente igual que uno válido", "Nunca se revela si el problema es el email o el estado de la cuenta", "sendForgotPassword() no envía correo en ese caso"] },
    { "dot": "emerald", "title": "Camino feliz", "items": ["sendForgotPassword() es un server action, no una API route separada", "El enlace de recuperación redirige a /auth/callback → /activate"] },
    { "dot": "cyan", "title": "Restablecimiento", "items": ["El cliente llama supabase.auth.updateUser() con la sesión de verifyOtp", "activateAccount() marca status: ACTIVE recién después de eso"] }
  ]
}
